{
  "expo": {
    "name": "Firebase Auth Starter",
    "slug": "firebase-auth-starter",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "description": "A React Native Firebase authentication starter for iOS, Android, and web.",
    "githubUrl": "https://github.com/alirazawatoo/mobile-firebase-auth-starter"
  }
}
